# Direct browser-to-AWS S3 uploads (same ReactS3 flow as the JBank reference).
REACT_APP_AWS_DIR_NAME=user-uploads/
REACT_APP_AWS_BUCKET_NAME=your_bucket_name
REACT_APP_AWS_REGION=your_bucket_region
REACT_APP_AWS_ACCESS_KEY_ID=your_access_key_id
REACT_APP_AWS_SECRET_ACCESS_KEY=your_secret_access_key
