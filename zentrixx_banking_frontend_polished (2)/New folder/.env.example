# Frontend configuration example
# Do not place AWS secret keys or other private credentials in a React frontend.
# Use a backend endpoint or short-lived pre-signed upload URLs for S3 uploads.
REACT_APP_AWS_DIR_NAME=
REACT_APP_AWS_BUCKET_NAME=
REACT_APP_AWS_REGION=
# Public client identifiers only, if your architecture explicitly requires them.
# Never expose REACT_APP_AWS_SECRET_ACCESS_KEY in a browser application.
